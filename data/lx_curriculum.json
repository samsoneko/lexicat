				"title": "Saying hello and goodbye",
				"text": "When greeting other people, the most important term is 'valén' ('hello'). To see someone of, the most common term is 'janta' ('bye')."
			}
		},
		{
			"type": "vocab",
			"index": 2,
			"content": {
				"options": ["valén", "janta"]
			}
		},
		{
			"type": "multiple_choice",
			"index": 3,
			"content": {
				"prompt": "How do you say 'hello'?",
				"options": ["valén", "janta"],
				"answer": "valén"
			}
		},
		{
			"type": "multiple_choice",
			"index": 4,
			"content": {
				"prompt": "How do you say 'goodbye'?",
				"options": ["valén", "janta"],
				"answer": "janta"
			}
		}
		]

			"type": "info",
			"index": 1,
			"content": {
				"title": "Modifying adjectives",
				"text": "When modifying adjectives, the word order of Lexin is opposite to the one found in English. Instead of saying something like 'blue book', one would place the adjective after the noun, such as in 'lean-acóno' (lit. 'flower-red')."
			}
		},
		{
			"type": "vocab",
			"index": 2,
			"content": {
				"options": ["lean", "ritón", "tala", "acóno"]
			}
		},
		{
			"type": "arrange",
			"index": 3,
			"content": {
				"prompt": "How do you say 'red flower'?",
				"options": ["lean", "acóno"],
				"answer": "lean acóno"
			}
		},
		{
			"type": "arrange",
			"index": 4,
			"content": {
				"prompt": "How do you say 'blue book'?",
				"options": ["ritón", "tala"],
				"answer": "ritón tala"
			}
		}
		]
